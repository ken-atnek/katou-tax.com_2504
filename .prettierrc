{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": [
        "*.scss"
      ],
      "options": {
        "tabWidth": 4,
        "printWidth": 80,
        "proseWrap": "always",
        "trimTrailingWhitespace": true
      }
    }
  ]
}